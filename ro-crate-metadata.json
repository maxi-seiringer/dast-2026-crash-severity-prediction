    {
      "@id": "01-load-merge.py",
      "@type": [
        "File",
        "SoftwareSourceCode"
      ],
      "name": "Load and Merge Pipeline Step",
      "programmingLanguage": {
        "@id": "https://www.python.org/"
      },
      "description": "This experiment predicts the severity of road traffic accidents by classifying them into Slight, Serious, or Fatal categories. The classification is based on conditions typically known at the time of an emergency call, with the aim of supporting dispatch centres in determining the appropriate emergency response, such as police, ambulance, or trauma teams. The data originates from the UK Road Safety Open Data (STATS19) for 2023, published by the UK Department for Transport under the Open Government Licence. The dataset consists of three linked CSV files containing collision, vehicle, and casualty information connected through a shared collision ID. Features used for prediction include road type, speed limit, weather conditions, lighting conditions, road surface conditions, time of day, day of the week, number of vehicles involved, and vehicle type. A Random Forest Classifier is trained using a 70/15/15 split for training, validation, and testing. The experiment produces histogram plots for feature exploration, feature importance visualisations, a confusion matrix, a classification report including precision, recall and F1-score metrics, predicted versus actual labels for the test set, and a serialized Random Forest model file.",      "input": [
        {
          "@id": "data/raw/collision.csv"
        },
        {
          "@id": "data/raw/vehicles.csv"
        },
        {
          "@id": "data/raw/casualty.csv"
        }
      ],
      "output": {
        "@id": "data/processed/merged.csv"
      }
    },

